{
  "name": "@dungeon-grades/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "audio:generate": "tsx src/scripts/generate-audio.ts",
    "audio:generate:force": "tsx src/scripts/generate-audio.ts --force"
  },
  "dependencies": {
    "@dungeon-grades/shared": "*",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.4.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
