# Copy to .env and fill in. Never commit .env.
# Classroom production: see docs/DEPLOY.md

# Teacher dashboard PIN. Required in production (NODE_ENV=production).
# Do not leave this as "teacher" on the classroom server.
TEACHER_PIN=

# Bind address. Behind nginx use 127.0.0.1 so students cannot skip the proxy.
# Dev default (unset) is 0.0.0.0
# HOST=127.0.0.1
# PORT=3001

# Public URL prefix. Production default is /gradeforge so the game
# sits next to other sites on the same nginx box. Local `npm run dev` ignores this.
BASE_PATH=/gradeforge

# Optional overrides. Unset = classroom JSON in server/data, audio in
# server/data/audio (checked in), UI from client/dist after npm run build.
# DATA_DIR=/var/lib/gradeforge
# AUDIO_DIR=/opt/gradeforge/server/data/audio
# CLIENT_DIST=/opt/gradeforge/client/dist
